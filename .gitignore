# ====================================================================
# DEPENDENCIES & PACKAGE MANAGERS
# ====================================================================
node_modules/
jspm_packages/
web_modules/
pnpm-lock.yaml
bun.lockb

# ====================================================================
# ENVIRONMENT VARIABLES & SECRETS (NEVER COMMIT THESE)
# ====================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.secret

# ====================================================================
# LOGS AND DIAGNOSTICS
# ====================================================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ====================================================================
# BUILD OUTPUTS & TEMPORARY FILES
# ====================================================================
dist/
build/
out/
target/
*.exe
*.dll
*.so
*.war
*.ear

# ====================================================================
# PYTHON SPECIFIC
# ====================================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.pytest_cache/

# ====================================================================
# IDEs & EDITORS (VS Code, IntelliJ, WebStorm)
# ====================================================================
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ====================================================================
# OPERATING SYSTEM SPECIFIC
# ====================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Ehthumbs.db
Desktop.ini

# Background source images — only backgrounds/web/ (optimized, ~1.9MB) is used by the site
public/backgrounds/*.jpg

# Design/source material kept locally for comparison only (full.html, reference.html,
# and the youngintach.org capture). Not part of the site build.
/reference/*

# ...except the original hand-written page. The Next port is verified pixel-for-pixel
# against it, and its final state (nav typography, scroll offsets) was never committed,
# so it stays in version control as the regression baseline.
!/reference/original-index.html

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo
